\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Phase 1: Static Structural Analysis}{3}{subsection.2.2}\protected@file@percent }
\newlabel{sec:phase1}{{2.2}{3}{Phase 1: Static Structural Analysis}{subsection.2.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Overview of the seven-phase AI-assisted R-to-Python conversion methodology.} The pipeline proceeds from static structural analysis (Phase~1) through build infrastructure (Phase~2), language dependency cataloguing (Phase~3), automated function conversion and assembly (Phase~4), code quality auditing (Phase~5), R test porting (Phase~6), and comprehensive test-suite construction with iterative bug resolution (Phase~7). The phase outputs form a directed chain of artefacts consumed by subsequent phases. Skills (top-level slash commands) and their sub-agents are indicated for each phase; the dispatch mode (sequential, parallel, or iterative) of each sub-agent fleet is shown explicitly.}}{4}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{4}{\textbf {Overview of the seven-phase AI-assisted R-to-Python conversion methodology.} The pipeline proceeds from static structural analysis (Phase~1) through build infrastructure (Phase~2), language dependency cataloguing (Phase~3), automated function conversion and assembly (Phase~4), code quality auditing (Phase~5), R test porting (Phase~6), and comprehensive test-suite construction with iterative bug resolution (Phase~7). The phase outputs form a directed chain of artefacts consumed by subsequent phases. Skills (top-level slash commands) and their sub-agents are indicated for each phase; the dispatch mode (sequential, parallel, or iterative) of each sub-agent fleet is shown explicitly}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Skill-agent orchestration architecture.} A skill (slash command) acts as an orchestrator: it assembles per-item context bundles from shared inputs and dispatches sub-agents in one of three modes. Sequential dispatch (Phases 1, 4, 6, and 7a) is used when each agent invocation must have access to the outputs of prior invocations. Parallel dispatch (Phase 3b) is used when agent invocations are independent and latency is the binding constraint. Iterative dispatch (Phase 7b) repeatedly invokes a fix-agent until a stopping criterion (all tests pass) is met.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:orchestration}{{2}{5}{\textbf {Skill-agent orchestration architecture.} A skill (slash command) acts as an orchestrator: it assembles per-item context bundles from shared inputs and dispatches sub-agents in one of three modes. Sequential dispatch (Phases 1, 4, 6, and 7a) is used when each agent invocation must have access to the outputs of prior invocations. Parallel dispatch (Phase 3b) is used when agent invocations are independent and latency is the binding constraint. Iterative dispatch (Phase 7b) repeatedly invokes a fix-agent until a stopping criterion (all tests pass) is met}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Example of the JSON artefact produced by the \texttt  {@analyze-r-file-dependencies} agent for a single R source file. The JSON object is keyed by function name, and each function maps to an object containing three lists: \texttt  {language\_dependencies} (calls to R built-in or standard-library functions), \texttt  {internal\_dependencies} (calls to other functions defined within the same package), and \texttt  {external\_dependencies} (calls through the Fortran or C foreign-function interface). This structured format allows subsequent agents to easily query the dependencies of each function for informed translation decisions.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:json_example}{{3}{6}{Example of the JSON artefact produced by the \agent {analyze-r-file-dependencies} agent for a single R source file. The JSON object is keyed by function name, and each function maps to an object containing three lists: \texttt {language\_dependencies} (calls to R built-in or standard-library functions), \texttt {internal\_dependencies} (calls to other functions defined within the same package), and \texttt {external\_dependencies} (calls through the Fortran or C foreign-function interface). This structured format allows subsequent agents to easily query the dependencies of each function for informed translation decisions}{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Dependency-level table for the 16 functions in \texttt  {KernSmooth}. The ``level'' column indicates the function's depth in the dependency graph, with 0 representing root functions that are not called by any other function, and higher levels indicating deeper dependencies, with ``(leaf)'' tags for leaf functions. The ``parents'' column lists the immediate callers of each function, while the ``children'' column lists the immediate callees. The ``file\_name'' column listing the name of the file containing each function is omitted for brevity since they are all \texttt  {all.R} in \texttt  {KernSmooth}.}}{7}{table.caption.5}\protected@file@percent }
\newlabel{tab:dag}{{1}{7}{Dependency-level table for the 16 functions in \pkg {KernSmooth}. The ``level'' column indicates the function's depth in the dependency graph, with 0 representing root functions that are not called by any other function, and higher levels indicating deeper dependencies, with ``(leaf)'' tags for leaf functions. The ``parents'' column lists the immediate callers of each function, while the ``children'' column lists the immediate callees. The ``file\_name'' column listing the name of the file containing each function is omitted for brevity since they are all \texttt {all.R} in \pkg {KernSmooth}}{table.caption.5}{}}
\abx@aux@cite{0}{peterson2009f2py}
\abx@aux@segm{0}{0}{peterson2009f2py}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Phase 2: Python Build Infrastructure}{8}{subsection.2.3}\protected@file@percent }
\newlabel{sec:phase2}{{2.3}{8}{Phase 2: Python Build Infrastructure}{subsection.2.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Phase 3: Language Dependency Catalogue and Translation Guide Generation}{8}{subsection.2.4}\protected@file@percent }
\newlabel{sec:phase3}{{2.4}{8}{Phase 3: Language Dependency Catalogue and Translation Guide Generation}{subsection.2.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Phase~3: language dependency extraction and parallel conversion guide generation.} The first stage extracts the complete call-site table (370 rows, 4 columns) from the R source via sequential agent dispatch. The second stage launches 46 sub-agent instances simultaneously---one per unique language dependency---each producing a Markdown guide specifying the exact Python translation strategy with code examples. Parallel dispatch is appropriate because the guide for each dependency is context-independent of all other guides.}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:phase3}{{4}{9}{\textbf {Phase~3: language dependency extraction and parallel conversion guide generation.} The first stage extracts the complete call-site table (370 rows, 4 columns) from the R source via sequential agent dispatch. The second stage launches 46 sub-agent instances simultaneously---one per unique language dependency---each producing a Markdown guide specifying the exact Python translation strategy with code examples. Parallel dispatch is appropriate because the guide for each dependency is context-independent of all other guides}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Excerpt from the language dependency call-site table. The full table contains 509 rows covering all 16 functions in \texttt  {KernSmooth}. Each row corresponds to a single call site of an R standard-library function, with columns for the dependency name, enclosing function name, line number, and complete call expression. The table is sorted by dependency name, function name, and line number so that all call sites for each unique dependency are contiguous, and all call sites for each unique function are contiguous, facilitating the subsequent guide generation step. The ``file\_name'' column listing the name of the file containing each function is omitted for brevity since they are all \texttt  {all.R} in \texttt  {KernSmooth}.}}{10}{table.caption.7}\protected@file@percent }
\newlabel{tab:call-site}{{2}{10}{Excerpt from the language dependency call-site table. The full table contains 509 rows covering all 16 functions in \pkg {KernSmooth}. Each row corresponds to a single call site of an R standard-library function, with columns for the dependency name, enclosing function name, line number, and complete call expression. The table is sorted by dependency name, function name, and line number so that all call sites for each unique dependency are contiguous, and all call sites for each unique function are contiguous, facilitating the subsequent guide generation step. The ``file\_name'' column listing the name of the file containing each function is omitted for brevity since they are all \texttt {all.R} in \pkg {KernSmooth}}{table.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Phase 4: Automated Function Conversion and Package Assembly}{11}{subsection.2.5}\protected@file@percent }
\newlabel{sec:phase4}{{2.5}{11}{Phase 4: Automated Function Conversion and Package Assembly}{subsection.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Phase~4: topologically ordered function conversion and package assembly.} Functions are converted in leaf-to-root order so that each conversion agent can inspect the Python calling convention of already-converted internal dependencies. The \texttt  {/convert-r-file-to-python} skill derives the conversion order from the dependency-level CSV produced in Phase~1 and dispatches the \texttt  {@convert-r-function-to-python} sub-agent sequentially. The \texttt  {/combine-python-functions-into-file} skill then assembles the 16 resulting JSON artefacts into the final \texttt  {\_\_init\_\_.py}, correcting import paths and deduplicating imports.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:phase4}{{5}{12}{\textbf {Phase~4: topologically ordered function conversion and package assembly.} Functions are converted in leaf-to-root order so that each conversion agent can inspect the Python calling convention of already-converted internal dependencies. The \skill {convert-r-file-to-python} skill derives the conversion order from the dependency-level CSV produced in Phase~1 and dispatches the \agent {convert-r-function-to-python} sub-agent sequentially. The \skill {combine-python-functions-into-file} skill then assembles the 16 resulting JSON artefacts into the final \texttt {\_\_init\_\_.py}, correcting import paths and deduplicating imports}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Example of the JSON artefact produced by the \texttt  {@convert-r-function-to-python} agent for a single R function (\texttt  {rlbin}). The JSON object contains three fields: \texttt  {imports} (a list of import statements required by the function), \texttt  {function\_prototype} (the complete Python function signature with type annotations), and \texttt  {function\_body} (a list of strings representing the lines of the function body). This structured format allows for systematic assembly into a Python file while ensuring that all necessary imports and correct function signatures are included.}}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:function_json}{{6}{13}{Example of the JSON artefact produced by the \agent {convert-r-function-to-python} agent for a single R function (\texttt {rlbin}). The JSON object contains three fields: \texttt {imports} (a list of import statements required by the function), \texttt {function\_prototype} (the complete Python function signature with type annotations), and \texttt {function\_body} (a list of strings representing the lines of the function body). This structured format allows for systematic assembly into a Python file while ensuring that all necessary imports and correct function signatures are included}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.6}Phase 5: Code Quality Audit and Namespace Refinement}{14}{subsection.2.6}\protected@file@percent }
\newlabel{sec:phase5}{{2.6}{14}{Phase 5: Code Quality Audit and Namespace Refinement}{subsection.2.6}{}}
