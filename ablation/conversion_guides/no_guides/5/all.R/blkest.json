{
  "imports": [
    "from typing import Any",
    "import numpy as np"
  ],
  "function_prototype": "def blkest(x: np.ndarray[Any, np.dtype[np.float64]], y: np.ndarray[Any, np.dtype[np.float64]], Nval: int, q: int) -> dict[str, float]:",
  "function_body": [
    "    # For obtaining preliminary estimates of",
    "    # quantities required for the \"direct plug-in\"",
    "    # regression bandwidth selector based on",
    "    # blocked qth degree polynomial fits.",
    "    n = len(x)",
    "",
    "    # Sort the (x, y) data with respect to the x's.",
    "    order = np.argsort(x, kind=\"mergesort\")",
    "    x = np.asarray(x, dtype=np.float64)[order]",
    "    y = np.asarray(y, dtype=np.float64)[order]",
    "",
    "    # Reimplementation of the Fortran subroutine blkest (src/blkest.f)",
    "    qq = q + 1",
    "    RSS = 0.0",
    "    th22e = 0.0",
    "    th24e = 0.0",
    "",
    "    idiv = n // Nval",
    "    for j in range(1, Nval + 1):",
    "        # For each member of the partition",
    "        ilow = (j - 1) * idiv + 1",
    "        iupp = j * idiv",
    "        if j == Nval:",
    "            iupp = n",
    "        nj = iupp - ilow + 1",
    "",
    "        xj = x[ilow - 1:iupp]",
    "        yj = y[ilow - 1:iupp]",
    "",
    "        # Obtain a q'th degree fit over current member of partition.",
    "        # Set up \"X\" matrix: column k (0-based) holds xj**k.",
    "        Xmat = np.zeros((nj, qq), dtype=np.float64)",
    "        Xmat[:, 0] = 1.0",
    "        for k in range(2, qq + 1):",
    "            Xmat[:, k - 1] = xj ** (k - 1)",
    "",
    "        # Least-squares solve via QR decomposition, mirroring the",
    "        # Fortran calls to dqrdc/dqrsl.",
    "        Qmat, Rmat = np.linalg.qr(Xmat)",
    "        coef = np.linalg.solve(Rmat, Qmat.T @ yj)",
    "",
    "        for i in range(nj):",
    "            fiti = coef[0]",
    "            ddm = 2.0 * coef[2]",
    "            ddddm = 24.0 * coef[4]",
    "            for k in range(2, qq + 1):",
    "                fiti = fiti + coef[k - 1] * xj[i] ** (k - 1)",
    "                if k <= (q - 1):",
    "                    ddm = ddm + k * (k + 1) * coef[k + 1] * xj[i] ** (k - 1)",
    "                    if k <= (q - 3):",
    "                        ddddm = ddddm + k * (k + 1) * (k + 2) * (k + 3) * coef[k + 3] * xj[i] ** (k - 1)",
    "            th22e = th22e + ddm ** 2",
    "            th24e = th24e + ddm * ddddm",
    "            RSS = RSS + (yj[i] - fiti) ** 2",
    "",
    "    sigsqe = RSS / (n - qq * Nval)",
    "    th22e = th22e / n",
    "    th24e = th24e / n",
    "",
    "    return {\"sigsqe\": sigsqe, \"th22e\": th22e, \"th24e\": th24e}"
  ]
}
