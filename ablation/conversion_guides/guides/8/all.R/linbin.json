{
  "imports": [
    "import numpy as np",
    "from typing import Any",
    "from . import _KernSmooth"
  ],
  "function_prototype": "def linbin(X: np.ndarray[Any, np.dtype[np.float64]], gpoints: np.ndarray[Any, np.dtype[np.float64]], truncate: bool = True) -> np.ndarray[Any, np.dtype[np.float64]]:",
  "function_body": [
    "    n = len(X)",
    "    M = len(gpoints)",
    "    trun = 1 if truncate else 0",
    "    a = gpoints[0]",
    "    b = gpoints[-1]",
    "",
    "    # Allocate the output buffer -- equivalent to R's double(M)",
    "    gcnts = np.zeros(M, dtype=np.float64)",
    "",
    "    # .Fortran(F_linbin, ...) -- writes into gcnts by reference",
    "    _KernSmooth.linbin(",
    "        np.asarray(X, dtype=np.float64),",
    "        n,",
    "        float(a),",
    "        float(b),",
    "        M,",
    "        trun,",
    "        gcnts,",
    "    )",
    "",
    "    return gcnts"
  ]
}
